#!/usr/bin/python
import sys, os, time, optparse, socket
from random import randint, random

PBYZ = 0.10
pidmap = {}



usage = "usage: %prog [options] <num nodes> <CA key>"
parser = optparse.OptionParser(usage=usage)

parser.add_option("-p", "--port", dest="port", type="int",
                  help="Start at this PORT number. Defaults to 12000.", default=12000)
parser.add_option("-a", "--address", dest="address", 
                  help="Bind to ADDRESS. Defaults to 127.0.0.1", default="127.0.0.1")
parser.add_option("-c", "--command", dest="command", 
                  help="Use COMMAND to start the firefly daemon. Defaults to fireflyd",
                  default="fireflyd")

(options, args) = parser.parse_args()



if len(args) < 2:
    print parser.print_help()
    sys.exit()

try:
    num = int(args[0])
except ValueError:
    print "Please supply a valid number."
    sys.exit()
    
for x in range(num):

    port = options.port + x
    print "Spawning %d at :%d" % (x, port)
    pid=os.spawnlp(os.P_NOWAIT, 
                   options.command,
                   options.command,
                   "-a", options.address,
                   "--verbose",
                   "-s",
                   "-b", "hosts",
                   "-p", str(port),
		   "-m", "100",
                   "-d",
                   args[1])
    pidmap[pid] = x
    time.sleep(0.3)
    
for pid, host in pidmap.items():
    print "Waitfor", host
    os.waitpid(pid,0)

print "All ok"

