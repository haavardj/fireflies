#!/usr/bin/env python3

import fireflies, os.path, sys, socket
import fireflies.crypto
import fireflies.persist
import sys
from optparse import OptionParser


parser = OptionParser(usage="""%prog [options] <ca path> <hostname | ->

Create a Fireflies X509 member key and certificate in the given ca path. The <ca path> arguments must contain the path to the CA's certificate repository. 
The created X509 certificate and the corresponding key will be stored in the CA's repository. If hostname is missing, then it will read from stdinn and generate
one certificacte per line.

WARNING: This program is unsecure and is intented for testing of Fireflies. It should not be used in real deployments.

Files:
   <path>/certs/<member name>  - The created certificate.
""")

parser.add_option("-o",
                  action="store_true", dest="overwrite", default=False,
                  help="Overwrite existing certificates.")
parser.add_option("-p", "--port", dest="port", type="int",
                      help="Portnumber to assign. Defaults to %s." % fireflies.defaultConfig['port'], default=fireflies.defaultConfig['port'])
parser.add_option("--password",
                  dest="password", default=None,
                  help="Password to use for reading the CA's private key. If not set, you will be prompted for one.")

(options, args) = parser.parse_args()

if not 1 <= len(args) <= 2:
 parser.print_help()
 sys.exit()

if len(args) == 2 and args[1] != "-":
 lines = [args[1],]
else:
 lines = [x.strip() for x in sys.stdin.readlines()]

if not os.path.exists(args[0]):
 print("CA does not exists.")
 sys.exit(0)
      
store = fireflies.persist.Store(args[0])
caKey = store.loadCAKey(options.password or fireflies.crypto.passwordPrompt("CA key password: "))

for line in lines:
 
 address = "%s:%d" % (socket.gethostbyname(line), options.port)

 if store.hasMemberCertificateWithAddress(address) and not options.overwrite:
  print("skipping %s existing" % address) 
  continue
  
 mpkey = fireflies.crypto.makePrivateRSAKey()
 store.savePrivateKey(mpkey, None)

 req = fireflies.crypto.makeRequest(address, mpkey, nickname=line)
 assert req.verify(mpkey)

 cert = store.newMemberCertificate(req, caKey)
 store.saveMemberCertificate(cert)
 
 assert fireflies.crypto.identityFromCertificate(cert)

 if len(args) == 2: print(cert.as_text())
 print("Saved:", store.filenameCertificate(cert)) 
