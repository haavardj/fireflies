#!/usr/bin/python

import sys, random, optparse

parser = optparse.OptionParser(usage="""%prog <fract> <active> <hostfile>
Generate a file of Byzantine behaving nodes for use on planetlab.

fract - indicates the probability that any given member is Byzantine.
active - indicates the chance of an active attack vs passive attack.
""")




(options, args) = parser.parse_args()
if len(args) != 3:
    parser.print_help()
    sys.exit(0)

fract = float(args[0])
active = float(args[1])
fn = args[2]

sites = file(fn).readlines()
sites = map(lambda x: x.strip(), sites)

byzantine = random.sample(sites, int(len(sites)*fract) )

random.shuffle(byzantine)

for nr, host in enumerate(byzantine):
    if float(nr) / len(byzantine) < active:
        print "%s %d" %(host, 2)
    else:
        print "%s %d" % (host, 1)

