#!/usr/bin/python

"""Generates Fireflies member keys and certificates."""


from fireflies import members, cert
from optparse import OptionParser
import os.path, sys, pickle, socket
from Crypto.PublicKey import RSA

hostaddr = socket.gethostbyname(socket.gethostname())
parser = OptionParser(usage="%prog [options] <ca key>")
parser.add_option("-o", "--output", dest="path", 
                  help="Write output to PATH. Defaults to working directory.", default="./")
parser.add_option("-p", "--port", dest="port", type="int",
                  help="Member's PORT. Defaults to 14377", default=14377)
parser.add_option("-i", "--ip", metavar="IP", dest="ip",
                  help="Members's IP. Defaults to %s." % hostaddr, default=hostaddr )

(options, args) = parser.parse_args()
if len(args) < 1:
    print parser.print_help()
    sys.exit()


cakey = None
try:
    cakey = pickle.load(file(args[0]))
except Exception, why:
    print "Can not load private key:", why
    sys.exit(0)
if not isinstance(cakey, cert.CAKey):
    print "Key is not a CA private key."
    sys.exit(0)


mkey = cert.MemberKey("%s:%d" %(options.ip, options.port), cakey.config["RSASIZE"])
mcert = mkey.getCertificate()
cakey.sign(mcert)

addr = "%s:%d" % (options.ip, options.port)
pickle.dump((mkey, mcert, None), file(os.path.join(options.path, addr+".key" ), "w"))
pickle.dump(mcert, file(os.path.join(options.path, addr+".crt"), "w"))

