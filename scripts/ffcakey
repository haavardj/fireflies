#!/usr/bin/python

"""Script for generating Fireflies CA keys."""

import fireflies.crypto
from optparse import OptionParser
import os.path, sys, pickle, socket


defaultConfig = fireflies.defaultConfig

parser = OptionParser(usage="%prog [options] <group name>")

parser.add_option("-e", "--tolerance", dest="tolerance", type="float", default=1.0,
                  help="Byzantine tolerance level. Default=1.0")


parser.add_option("-p", metavar="NUMBER", dest="pByz", type="float", default=0.20,
                  help="Uniform probability that a member is Byzantine. Default=0.20")

parser.add_option("-s", metavar="NUMBER", dest="maxGroupSize", type="int", default=1000,
                  help="Max size of a group. Default=1000")

(options, args) = parser.parse_args()

if os.path.exists(args[0]):
    print "Path exists. Please remove."
    sys.exit(0)

store = fireflies.crypto.PKIStore(args[0])
store.newCA(os.path.basename(args[0]), options.maxGroupSize, options.pByz, options.tolerance)
