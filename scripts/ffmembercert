#!/usr/bin/python

"""Script for generating Fireflies member certificates keys."""

import fireflies.crypto
from optparse import OptionParser
import os.path, sys, socket
import M2Crypto


parser = OptionParser(usage="%prog [options] <group name> <member address>")

parser.add_option("-n", dest="nick", type="str", default=None,
                  help="Member nick-name.")
parser.add_option("--password",
                  dest="password", default=None,
                  help="Password to use. If not set, you will be asked for a password when loading and saving keys.")

(options, args) = parser.parse_args()

if not os.path.exists(args[0]):
 print "CA does not exist."
 sys.exit(0)
 
if options.password:
 passwdcb = lambda x: options.password
else:
 passwdcb= M2Crypto.util.passphrase_callback
        
store = fireflies.crypto.PKIStore(args[0])
caPkey = store.loadCAKey(callback=passwdcb)
caCert = store.loadCACertificate()


mPKey = fireflies.crypto.generatePrivateKey()
req = fireflies.crypto.makeRequest(args[1], mPKey, nickname=options.nick)
mCert = fireflies.crypto.makeCert(req, caCert, caPkey)

print mCert.as_text()

store.saveMemberCertificate(mCert)
store.savePrivateKey(mPKey, mCert, passwdcb)

