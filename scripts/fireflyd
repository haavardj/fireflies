#!/usr/bin/env python

import warnings
warnings.filterwarnings(action="ignore", category=DeprecationWarning)
del warnings

from twisted.internet import reactor, task
import random, sys, os.path, logging, socket, pickle, os, glob
import logging.handlers
import fireflies.agent, fireflies.crypto, fireflies.gossip5
#from fireflies import members, fd, crypto, group, stats, gossip
from Crypto.Util.number import long_to_bytes, bytes_to_long
random.seed()

from twisted.python import threadable
threadable.init()
del threadable

if __name__ == "__main__":
    
    from optparse import OptionParser
    parser = OptionParser(usage="%prog [options] <CA key/cert>", version="%%prog %s" % fireflies.version)
    hostaddr = socket.gethostbyname(socket.gethostname())
    parser.add_option("-a", "--address", dest="address",
                      help="Bind to ADDRESS. Defaults to %s." % hostaddr, default=hostaddr )
    parser.add_option("-p", "--port", dest="port", type="int",
                      help="Bind PORT.", default=fireflies.defaultPort)
    parser.add_option("-k", "--key", dest="keydir", 
                      help="Store and load private keys and note from KEYDIR.", default="./")
    parser.add_option("-r", "--rundir",
                      dest="rundir", default=None,
                      help="Checkpoint notes and certificates in this directory.")    
    parser.add_option("-l", "--logdir", dest="logdir", 
                      help="When daemon, write logs to LOGDIR.", default="./")
    parser.add_option("-c", "--cache", dest="cachedir", default="./",
                      help="Look in the CACHEDIR for member's notes.")
#    parser.add_option("-g", "--group", dest="group", default=None,
#                      help="Run in group.")
#    parser.add_option("-u", "--user", dest="user", default=None,
#                      help="Run as USER.")
    parser.add_option("-m", "--max", dest="max", type="int", default=1000,
                      help="Do not use more than MAX notes from the cache.")
    parser.add_option("-d", "--daemon",
                      action="store_true", dest="daemon", default=False,
                      help="Run as daemon.")
    parser.add_option("-s", "--stats",
                      action="store_true", dest="stats", default=False,
                      help="Enable the web-stats.")
    parser.add_option("--verbose",
                      action="store_true", dest="verbose", default=False,
                      help="Verbose output.")
    parser.add_option("-b", "--byzantine",
                      dest="byzantine", default=None,
                      help="Checks in this file if the member is supposed to be Byzantine.")
    
    (options, args) = parser.parse_args()
    if len(args) < 1:
        print parser.print_help()
        sys.exit()


    # The first argument can either be a CA certificate, or a CA
    # Key. If given the key, we can make our own member certificats. 
    groupKey = groupCertificate = None
    try:
        ca = pickle.load(file(args[0]))
        if isinstance(ca, fireflies.crypto.CAKey):
            groupKey = ca
            groupCertificate = ca.getCertificate()
        elif isinstance(ca, fireflies.crypto.CACertificate):
            groupCertificate = ca 
        else:
            raise TypeError

        if not groupCertificate.verify(groupCertificate):
            raise RuntimeError("CA certificate not valid.")
    except Exception, why:
        print "Unable to load CA key/cert.", why
        sys.exit()


    # Change user/group
    #import pwd, grp
    #if options.user:
    #    os.seteuid(pwd.getpwnam(options.user)[2])
    #if options.group:
    #    os.seteuid(grp.getgrnam(options.group)[2])
    #del pwd
    #del grp
    
   
    # Set logging verbosity
    l = logging.getLogger()
    if options.verbose:
        l.setLevel(logging.DEBUG)
    else:
        l.setLevel(logging.INFO)


    # Make sure address is an IP address.
    options.address = socket.gethostbyname(options.address.lower())

    # Make sure required paths exists
    for path in [options.keydir, options.logdir, options.rundir, options.cachedir]:
        if not path: continue        
        if not os.path.exists(path):
            os.mkdir(path)
        elif not os.path.isdir(path):
            print "%s is not a directory.", path
            sys.exit(0)
        elif not os.access(path, os.R_OK | os.W_OK):
            print "%s access error.", path
            sys.exit(0)

    # Become a daemon?
    if options.daemon:
        if os.fork(): 
            os._exit(0)
        os.setsid() #???
        os.umask(077)
        for i in range(3):
            try:
                os.close(i)
            except OSError, e:
                if e.errno != errno.EBADF:
                    raise
        log_hdlr = logging.handlers.RotatingFileHandler(os.path.join(options.logdir,
                                                                     "%s:%d.log" % (options.address,
                                                                                    options.port)),
                                                                     "a", 100000000, 10)
    else:
        log_hdlr = logging.StreamHandler(sys.stdout)

    # Setup Logging
    formatter = logging.Formatter('%(asctime)s %(message)s', "%d-%m-%H:%M:%S")
    log_hdlr.setFormatter(formatter)
    logging.getLogger().addHandler(log_hdlr)

    #Check byzantine setting.
    byzantine = 0
    if options.byzantine:
        for line in file(options.byzantine).readlines():
            line = line.strip()
            if line == "": continue
            name, behaviour = line.split()
            if name == "%s:%d" %(options.address, options.port):
                byzantine = int(behaviour)
            
    
    #
    # Load own keys and notes.
    #
    
    myKey = myCertificate = myNote = None

    # Create or load member key and certificate

    try:
        path = os.path.join(options.keydir, "%s:%d.priv" % (options.address, options.port))
        myKey, myCertificate, myNote = pickle.load(file(path))
    except (pickle.UnpicklingError, IOError):
        if not groupKey: raise        
        
    if not myKey:
        myKey = fireflies.crypto.MemberKey("%s:%d" %(options.address, options.port))
        myCertificate = myNote = None
        
    group = fireflies.group.Group(groupCertificate, myKey)
        
    if not myCertificate:
        if not groupKey: raise RuntimeError, "Cannot create member certificate without group key"        
        myCertificate = myKey.getCertificate()
        groupKey.sign(myCertificate)
        myNote = None
        
    
    group.addCertificate(myCertificate)
    me = group.getMemberByCertificate(myCertificate)
    isinstance(me, fireflies.members.Member)
    
    if not myNote:
        
        me = group.getMemberByCertificate(myCertificate)
        myNote = fireflies.members.createRebuttal(me, group, myKey)        
        myNote.badness = byzantine

    myKey.sign(myNote)
    group.addNote(myNote)
                
    logging.info("Me = %s on %s (badness=%d)", 
                 bytes_to_long(myCertificate.serial), 
                 myCertificate.address, 
                 myNote.badness
                 )


    #
    # Load other certificates and notes.
    #
    bootnodes = []
    pubfiles = []
    if options.cachedir:
        pubfiles = glob.glob(os.path.join(options.cachedir, "*.pub"))
        
    random.shuffle(pubfiles)
    m = min(len(pubfiles), options.max)
    for path in pubfiles[0:m]:
        try:
            ocert, onote = pickle.load(file(path))
        except (EOFError, pickle.UnpicklingError, IOError):
            logging.warning("Member cache: Error loading cert/note from %s.", path)
            continue

        if not (isinstance(ocert, fireflies.crypto.MemberCertificate) or isinstance(onote, fireflies.members.Note)):
            logging.warning("Not valid data in %s", path)
            continue
        
        if not fireflies.members.isValidMask(onote.mask, group.T):
            continue        
        
        if ocert.serial == myCertificate.serial:
            logging.info("Member cache: Member in %s is me. Skipping", path)
            continue                
        if not ( (groupCertificate.verify(ocert)) and
                 (ocert.serial == onote.serial) and
                 (ocert.verify(onote))):
            logging.warning("Member cache: Skipping invalid cert/note in %s.", path)
            continue

        bootnodes.append((ocert, onote))

    from twisted.python import log
    import sys
    log.startLogging(sys.stdout)

    for c, n in bootnodes:
        group.addCertificate(c)
        group.addNote(n)

    if options.rundir:
        statefile = os.path.join(options.rundir, "%s.dat" % myCertificate.address)
        if os.path.exists(statefile):
            try:
                cstate, nstate, astate = pickle.load(file(statefile))
                for c in cstate:
                    group.addCertificate(c)
                for n in nstate:
                    group.addNote(n)
                for a in astate:
                    group.addAccusation(a)
            except IOError:
                pass
    
    # Save state. We need to do it here to make shure we do not lose
    # the data if the program crashes.
    path = os.path.join(options.keydir, "%s.priv" % myCertificate.address)
    pickle.dump( (myKey, myCertificate, me.getNote()), file(path, "w"))
    path = os.path.join(options.keydir, "%s.pub" % myCertificate.address)
    pickle.dump( (myCertificate, me.getNote()), file(path, "w"))

    # Start the web-stat server. The web-stat server modifies
    # checkpoints the stats to the log. If it's not running, we need
    # to do it here.
    #if options.stats:
    #    import fireflies.web
    #    ws = fireflies.web.NodeViewer(mgroup)
    #    ws.start()
    # find bogomips speed
    #bogomips = 0
    #try:
        #lines = file("/proc/cpuinfo").readlines()
    #except Exception:
        #logging.warning("unable to open /proc/cpuinfo.")
    #else:
        #while 1:
            #if len(lines) == 0:
                #logging.warning("unable to find bogomips value.")
                #break

            #line = lines.pop(0)
            #if not line.startswith("bogomips"): continue
            #bogomips = line.split(":")[1]
            #bogomips = bogomips.strip()
            #bogomips = float(bogomips)
            #logging.info("calculating load using bogomips=%f", bogomips)
            #break


    #global sold, snew
    #sold = snew = stats.Stats()
    #sold.cputime = os.times()[0] * bogomips
    #t = fireflies.time.time()

    def doCheckpoint():
        global sold, snew
        snew = stats.collect(mgroup)
        snew.cputime = os.times()[0] * bogomips
        logging.info("checkpoint %s %d %d" % (str( (snew - sold)), snew.members, snew.fmembers) )
        sold = snew

    def doWriteState():
        assert options.rundir
        logging.info("writing state.")
        statefile = os.path.join(options.rundir, "%s.dat" % mgroup.memberCertificate.address)

        cstate = []
        nstate = []
        astate = []
        for member in mgroup.view.pRing:            
            cstate.append(member.cert)
            if member.note:
                nstate.append(member.note)
            astate.extend(member.pAccusations.values())

        try:
            pickle.dump((cstate, nstate, astate), file(statefile, "w"))
        except Exception, why:
            logging.error("Failed saving %s", path)
   
    def failback(msg):
        logging.exception(msg)
        
    #checkpointTask = task.LoopingCall(doCheckpoint)
    #checkpointTask.start(10).addErrback(failback)

    #if options.rundir:
    #    rundirTask = task.LoopingCall(doWriteState)
    #    rundirTask.start(60*10).addErrback(failback)

    
    import fireflies.mesh
    mesh = fireflies.mesh.Mesh(me)

    h,p = me.getAddress().split(":")
    p = int(p)    
    reactor.listenTCP(p, mesh, interface=h)
    logging.info("Binding Mesh to tcp %s:%d", h, p)    
    
    
    
    try:
        reactor.run()
    except Exception, why:
        logging.exception("reactor crash? %s", why)

    # Save the note. It might been updated since our last save.
    if options.keydir != None:
        try:
            path = os.path.join(options.keydir, "%s.pub" % myCertificate.address)
            pickle.dump( (myCertificate, me.getNote()), file(path, "w"))
        except Exception, why:
            logging.error("Failed saving %s", path)
        else:
            logging.info("Note saved in %s ", options.keydir)

    logging.info("Shutdown")
