#!/usr/bin/python

import warnings

warnings.filterwarnings(action="ignore", category=DeprecationWarning)

from twisted.internet import reactor, task
import random, sys, os.path, logging, socket, pickle, os, glob
import logging.handlers
import fireflies
from fireflies import gossip, state, fd, crypto, group, stats
import M2Crypto

from Crypto.Util.number import long_to_bytes, bytes_to_long

random.seed()

from twisted.python import threadable
threadable.init()
del threadable


if __name__ == "__main__":
    
    from optparse import OptionParser
    parser = OptionParser(usage="%prog [options] <Storage path>", version="%%prog %s" % fireflies.version)
    hostaddr = socket.gethostbyname(socket.gethostname())
    parser.add_option("-a", "--address", dest="address",
                      help="Bind to ADDRESS. Defaults to %s." % hostaddr, default=hostaddr )
    parser.add_option("-p", "--port", dest="port", type="int",
                      help="Bind PORT. Defaults to 14377", default=14377)
    parser.add_option("--public",
                      dest="public", default=None,
                      help="Path to public state storage.")    
    parser.add_option("--cakey",
                      dest="ca", default=None,
                      help="Path to CA's private key.")        
    parser.add_option("-l", "--logdir", dest="logdir", 
                      help="When daemon, write logs to LOGDIR.", default="./")
    parser.add_option("-g", "--group", dest="group", default=None,
                      help="Run in group.")
    parser.add_option("-u", "--user", dest="user", default=None,
                      help="Run as USER.")
    parser.add_option("-m", "--max", dest="max", type="int", default=1000,
                      help="Do not use more than MAX notes from the cache.")
    parser.add_option("-d", "--daemon",
                      action="store_true", dest="daemon", default=False,
                      help="Run as daemon.")
    parser.add_option("-r", "--rundir",
                      dest="rundir", default="./",
                      help="Rundir.")

    parser.add_option("-s", "--stats",
                      action="store_true", dest="stats", default=False,
                      help="Enable the web-stats.")
    parser.add_option("--verbose",
                      action="store_true", dest="verbose", default=False,
                      help="Verbose output.")
    parser.add_option("-b", "--byzantine",
                      dest="byzantine", default=None,
                      help="Checks in this file if the member is supposed to be Byzantine.")

    (options, args) = parser.parse_args()
    
    if len(args) < 1:
        print parser.print_help()
        sys.exit()

    myAddress = "%s:%d" % (options.address, options.port)

    # Change user/group
    import pwd, grp
    if options.user:
        os.seteuid(pwd.getpwnam(options.user)[2])
    if options.group:
        os.seteuid(grp.getgrnam(options.group)[2])
    del pwd
    del grp
       
    # Set logging verbosity
    l = logging.getLogger()
    if options.verbose:
        l.setLevel(logging.DEBUG)
    else:
        l.setLevel(logging.INFO)
        
    # Become a daemon?
    if options.daemon:
        if os.fork(): 
            os._exit(0)
        os.setsid() #???
        os.umask(077)
        for i in range(3):
            try:
                os.close(i)
            except OSError, e:
                if e.errno != errno.EBADF:
                    raise
        log_hdlr = logging.handlers.RotatingFileHandler(os.path.join(options.logdir, myAddress), "a", 100000000, 10)
    else:
        log_hdlr = logging.StreamHandler(sys.stdout)
                
    formatter = logging.Formatter('%(asctime)s %(message)s', "%d-%m-%H:%M:%S")
    log_hdlr.setFormatter(formatter)
    logging.getLogger().addHandler(log_hdlr)

    #Check byzantine setting.
    byzantine = 0
    if options.byzantine:
        for line in file(options.byzantine).readlines():
            line = line.strip()
            if line == "": continue
            name, behaviour = line.split()
            if name == myAddress:
                byzantine = int(behaviour)

                
    
    #
    # Load own keys and notes.
    #
    # The first argument can either be a CA certificate, or a CA
    # Key. If given the key, we can make our own member certificats. 
    try:
        store = crypto.PKIStore(args[0])
    except Exception, why:
        print "Unable to initialize store.", why
        sys.exit(0)



    groupCert = groupKey = myCert = myKey = myNote = None
    
    try:
        groupCert = store.loadCACertificate()
    except:
        print "Unable to load group certificate."
        sys.exit(0)
    
    if store.hasMemberCertificateWithAddress(myAddress):        
        myCert = store.loadMemberCertificateByAddress(myAddress)
    else:
        if not store.hasCAKey():
            print "Unable to find or create member certificate for address=%s" % myAddress
            sys.exit(0)
        else:
            store.newMember(myAddress)
            myCert = store.loadMemberCertificateByAddress(myAddress)

    try:
        myKey = store.loadPrivateKeyForCert(myCert)
    except KeyError, why:
        print "Unable to load private key.", why
        sys.exit()

    try:
        myNote = store.loadNoteFromCert(myCert)
    except KeyError, why:
        print "Cannot find note. Will create new one.", why
            
    mgroup = group.Group(groupCert, myKey, myCert, myNote)
    logging.info("Me = %s on %s", mgroup.getMe().getIdentity(), mgroup.getMe().getAddress())
    fd = fireflies.fd.FailureDetector(mgroup)
    gossip = fireflies.gossip.Gossip(mgroup)
    mgroup.startService()


    #
    # Load other certificates and notes.
    #
    
    for cert in store.loadMemberCertificates():
        mgroup.view.addCertificate(cert)
        
    for note in store.loadNotes():
        mgroup.view.addNote(note)
        
    for acc in store.loadAccusations():
        mgroup.view.addAccusation(acc)

    # Start the web-stat server. The web-stat server modifies
    # checkpoints the stats to the log. If it's not running, we need
    # to do it here.
    if options.stats:
        import fireflies.web
        ws = fireflies.web.NodeViewer(mgroup)
        ws.start()


    # find bogomips speed
    if options.public:
        cacheStore = crypto.PKIStore(options.public)
        for cert in cacheStore.loadMemberCertificates():
            mgroup.view.addCertificate(cert)
            
        for note in cacheStore.loadNotes():
            mgroup.view.addNote(note)
        
        for acc in cacheStore.loadAccusations():
            mgroup.view.addAccusation(acc)
        
    bogomips = 0

    try:
        lines = file("/proc/cpuinfo").readlines()
    except Exception:
        logging.warning("unable to open /proc/cpuinfo.")
    else:
        while 1:
            if len(lines) == 0:
                logging.warning("unable to find bogomips value.")
                break

            line = lines.pop(0)
            if not line.startswith("bogomips"): continue
            bogomips = line.split(":")[1]
            bogomips = bogomips.strip()
            bogomips = float(bogomips)
            logging.info("calculating load using bogomips=%f", bogomips)
            break

    global sold, snew
    sold = snew = stats.Stats()
    sold.cputime = os.times()[0] * bogomips
    t = fireflies.time.time()

    def doCheckpoint():
        global sold, snew
        snew = stats.collect(mgroup)
        snew.cputime = os.times()[0] * bogomips
        logging.info("checkpoint %s %d %d" % (str( (snew - sold)), snew.members, snew.fmembers) )
        sold = snew
        

    def doWriteState():
        assert options.rundir
        return
        logging.info("writing state.")
        statefile = os.path.join(options.rundir, "%s.dat" % mgroup.getMe().getAddress())

        cstate = []
        nstate = []
        astate = []
        for member in mgroup.view.pRing:            
            cstate.append(member.cert)
            if member.note:
                nstate.append(member.note)
            astate.extend(member.pAccusations.values())

        try:
            pickle.dump((cstate, nstate, astate), file(statefile, "w"))
        except Exception, why:
            logging.error("Failed saving %s", path)


    def failback(msg):
        logging.exception(msg)
        
    checkpointTask = task.LoopingCall(doCheckpoint)
    checkpointTask.start(10).addErrback(failback)

    #if options.rundir:
    #    rundirTask = task.LoopingCall(doWriteState)
    #    rundirTask.start(60*10).addErrback(failback)

    try:
        reactor.run()
    except Exception, why:
        logging.exception("reactor crash? %s", why)

    store.saveGroup(mgroup)

    logging.info("Shutdown")
