#!/usr/bin/env python3

"""Show lines in file one that are not in file two."""

import sys

if len(sys.argv) != 3:
	print("Usage: %s <file 1> <file 2>" % sys.argv[0])

l1 = open(sys.argv[1]).readlines()
l2 = open(sys.argv[2]).readlines()

l1 = [x.strip() for x in l1]
l2 = [x.strip() for x in l2]

for h in l1:
    if h not in l2: print(h)
